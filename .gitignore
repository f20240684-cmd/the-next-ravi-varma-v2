__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
*.egg-info/
build/
dist/
.pytest_cache/

# --------------------------------------------------------------------------
# Data: images are never committed (raw scans are ~400 MB; rebuild them with
# `python scripts/download_dataset.py --from-metadata`). The small text
# artefacts that define the dataset ARE committed so it is reproducible and
# auditable: metadata (provenance + captions), structured caption sidecars,
# the validation report, the training manifest and the held-out list.
# --------------------------------------------------------------------------
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/manifest.jsonl
data/captions/*
!data/captions/.gitkeep
!data/captions/*.json
data/metadata/*
!data/metadata/.gitkeep
!data/metadata/metadata.jsonl
!data/metadata/validation_report.json
data/reference/*
!data/reference/.gitkeep
!data/reference/reference.jsonl

# Model weights stay out of git, EXCEPT the final v3 LoRA (12.8 MB): without it a
# fresh clone cannot reproduce a single styled image. Checkpoints and v1/v2 stay local.
checkpoints/lora/*
!checkpoints/lora/.gitkeep
!checkpoints/lora/ravi_varma_v3/
checkpoints/lora/ravi_varma_v3/*
!checkpoints/lora/ravi_varma_v3/pytorch_lora_weights.safetensors
!checkpoints/lora/ravi_varma_v3/training_config.yaml
!checkpoints/lora/ravi_varma_v3/training_summary.json
!checkpoints/lora/ravi_varma_v3/loss_history.csv
*.ckpt
*.bin
*.safetensors
!checkpoints/lora/ravi_varma_v3/pytorch_lora_weights.safetensors

# Outputs: logs and smoke tests are scratch; curated result images and
# evaluation summaries are kept.
outputs/logs/*
!outputs/logs/.gitkeep
outputs/smoke_test/
outputs/evaluations/**/qualitative_review.csv.bak
*.zip

# Notebooks checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Downloaded / extracted Colab results (contents are unpacked into the project)
/ravi_varma_results/
# Per-checkpoint comparison renders (regenerate with scripts/generate.py --lora-path ...)
outputs/generated/ckpt_*/
